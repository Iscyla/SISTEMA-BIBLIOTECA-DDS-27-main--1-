<!-- Importação do Header -->
<%- include('partials/header') %>

<main class="container flex-grow-1">
  <h1 class="text-center">Estou na pagina de login</h1>

  <div class="d-flex flex-column">
    <form action="/usuarios/login" method="post">
      <!-- Caixinha de Email -->
      <div class="form-group">
        <label for="email"> Email: </label>
        <input type="email" name="email" id="email" required />
      </div>

      <!-- Caixinha de senha -->
      <div class="form-group">
        <label for="senhar"> Senha: </label>
        <input type="password" name="password" id="password" required />
      </div>

      <!-- Botão de envio -->
      <button type="submit" class="btn-subtle theme-succes mt-3">Entrar</button>
    </form>
  </div>
</main>

<!-- Importação do Footer -->
<%- include('partials/footer') %>
